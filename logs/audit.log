<?php
/**
 * logger.php
 * Sistema de log profesional de auditoría para Inventario AVMC
 * Versión: 1.2 optimizado y corregido
 * Autor: Brian Sierra
 */

date_default_timezone_set('America/Argentina/Buenos_Aires');

/**
 * Registra un evento en el log correspondiente.
 *
 * @param string $usuario  Nombre o ID del usuario que ejecuta la acción.
 * @param string $accion   Acción realizada (ej: "LOGIN", "SUBIR ARCHIVO", etc.).
 * @param string $detalle  Detalles adicionales de la acción.
 * @param string $tipo     Tipo de log: "transaccion" o "instalacion".
 */
function log_event($usuario, $accion, $detalle = "", $tipo = "transaccion") {
    $log_dir = __DIR__;

    if (!file_exists($log_dir)) {
        mkdir($log_dir, 0755, true);
    }

    $archivo = ($tipo === "instalacion")
        ? "$log_dir/log_instalacion.csv"
        : "$log_dir/log_transacciones.csv";

    $fecha = date("Y-m-d");
    $hora = date("H:i:s");
    $ip = $_SERVER['REMOTE_ADDR'] ?? 'CLI';

    // Sanitizar datos para evitar romper el CSV
    $usuario = str_replace(['"', "\n", "\r", ','], '', $usuario);
    $accion  = str_replace(['"', "\n", "\r", ','], '', $accion);
    $detalle = str_replace(['"', "\n", "\r", ','], '', $detalle);

    $linea = "\"$fecha\",\"$hora\",\"$usuario\",\"$accion\",\"$detalle\",\"$ip\"\n";

    // Si el archivo no existe, agregar encabezado
    if (!file_exists($archivo)) {
        $encabezado = "\"Fecha\",\"Hora\",\"Usuario\",\"Accion\",\"Detalle\",\"IP\"\n";
        file_put_contents($archivo, $encabezado, LOCK_EX);
    }

    file_put_contents($archivo, $linea, FILE_APPEND | LOCK_EX);
}
?>
