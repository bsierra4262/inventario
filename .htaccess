# =====================================================================
#  INTELLIHELP Asset Vault — .htaccess (subdominio desarrollo)
#
#  Este subdominio vive DENTRO de un WordPress + Wordfence en el dominio
#  padre. Necesitamos anular directivas heredadas que rompen el app.
# =====================================================================

# ── CRÍTICO: Anular Wordfence WAF heredado ────────────────────────
# El WP padre setea auto_prepend_file = wordfence-waf.php → causa 500
# en cada .php de nuestro app porque Wordfence asume contexto WP.
<IfModule LiteSpeed>
    php_value auto_prepend_file none
</IfModule>
<IfModule lsapi_module>
    php_value auto_prepend_file none
</IfModule>
<IfModule mod_php.c>
    php_value auto_prepend_file none
</IfModule>
<IfModule mod_php7.c>
    php_value auto_prepend_file none
</IfModule>
<IfModule mod_php8.c>
    php_value auto_prepend_file none
</IfModule>

# ── Sesión ────────────────────────────────────────────────────────
# Va acá y no en .user.ini porque este hosting NO lee .user.ini (se verificó:
# los valores llegan vacíos), pero sí aplica php_value — que es justamente lo
# que hace funcionar el auto_prepend_file de arriba.
#
# El nombre propio de cookie es importante: con `PHPSESSID` convivían dos
# cookies del mismo nombre (una host-only del login y otra con Domain= que
# dejaba logout.php), el navegador mandaba las dos y PHP se quedaba con la
# vieja. El login entraba y el request siguiente aparecía sin sesión.
<IfModule LiteSpeed>
    php_value session.name AVSESSID
    php_value session.cookie_httponly 1
    php_value session.cookie_secure 1
    php_value session.cookie_samesite Lax
    php_value session.use_strict_mode 1
    php_value session.use_only_cookies 1
    php_value session.gc_maxlifetime 28800
    php_value display_errors 0
    php_value expose_php 0
</IfModule>
<IfModule lsapi_module>
    php_value session.name AVSESSID
    php_value session.cookie_httponly 1
    php_value session.cookie_secure 1
    php_value session.cookie_samesite Lax
    php_value session.use_strict_mode 1
    php_value session.use_only_cookies 1
    php_value session.gc_maxlifetime 28800
    php_value display_errors 0
</IfModule>

# ── Reset de RewriteEngine para no heredar reglas de WordPress ───
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Forzar HTTPS
    RewriteCond %{HTTPS} !=on
    RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

    # Bloquear el árbol .git completo. Hoy Hostinger lo tapa por su cuenta,
    # pero eso es configuración del hosting, no del proyecto: si migramos,
    # /.git/config queda descargable y con él todo el código y su historia.
    RewriteRule (^|/)\.git(/|$) - [F,L]

    # Directorios que nunca deben servirse por HTTP.
    # logs/ contenía audit.log descargable (IPs, emails, eventos de login).
    # backend/temp/ recibe uploads con el nombre original del archivo.
    RewriteRule ^logs(/|$)          - [F,L]
    RewriteRule ^backend/temp(/|$)  - [F,L]
    RewriteRule ^bin(/|$)           - [F,L]
    RewriteRule ^test(/|$)          - [F,L]
    RewriteRule ^md(/|$)            - [F,L]

    # core/ e includes/ son librería, no entry points: se incluyen por __DIR__
    # desde el filesystem y nunca se piden por URL. Estaban servidos igual:
    # /core/config/platform.php, /core/db/TenantDB.php y /backend/db.php
    # devolvían 200 (cuerpo vacío, pero ejecutándose), e
    # /includes/layout/head.php devolvía 500 — la prueba de que correr un
    # include fuera de su contexto genera errores. Hoy no se filtra nada porque
    # display_errors está en 0; con un warning visible o un archivo que imprima
    # algo, sí. Se bloquea la superficie entera en vez de confiar en eso.
    RewriteRule ^core(/|$)          - [F,L]
    RewriteRule ^includes(/|$)      - [F,L]

    # backend/ no se puede bloquear entero: ahí viven los endpoints reales
    # (edit, delete, export…). Pero db.php y csrf.php son librería, se incluyen
    # por __DIR__ y nunca se piden por URL. Pedidos directos devolvían 200, y
    # db.php además arrancaba sesión y abría una conexión a la base del tenant en
    # cada pedido: superficie y trabajo sin ninguna razón.
    RewriteRule ^backend/(db|csrf)\.php$ - [F,L]
</IfModule>

# ── Archivos sensibles: nunca por HTTP ────────────────────────────
# composer.lock revelaba la versión exacta de cada dependencia;
# deploy.sh, la mecánica del despliegue.
#
# `json` está en la lista por auth/credentials.json: el patrón sólo cubría
# `composer.json`, así que cualquier otro .json se servía en texto plano. Hoy
# da 404 nada más que porque .gitignore lo mantiene fuera del deploy — es decir
# que la protección era "el archivo no está", no "el archivo no se sirve". Un
# upload manual por FTP o un .gitignore mal editado y queda el client_secret
# descargable. Nada del front pide un .json (el backup de empresa lo genera
# empresa_backup.php con Content-Disposition, no es un archivo estático), así
# que bloquear la extensión entera no rompe nada.
<FilesMatch "(^\.|composer\.(json|lock)$|\.(sh|md|json|lock|sql|log|ini|bak|orig|dist|example)$)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Deny from all
    </IfModule>
</FilesMatch>

# ── Cabeceras de seguridad ────────────────────────────────────────
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=()"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
    # Oculta la versión de PHP (expose_php=1 en el php.ini del hosting)
    Header always unset X-Powered-By
    Header unset X-Powered-By
</IfModule>

# Bloquear listado de directorios
Options -Indexes
ServerSignature Off
