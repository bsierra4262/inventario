# =====================================================================
#  INTELLIHELP Asset Vault — Apache config
#  Funciona igual en cualquier dominio/subdominio donde se aloje.
# =====================================================================

AddDefaultCharset UTF-8
RewriteEngine On

# ── Forzar HTTPS (cualquier dominio) ───────────────────────────────
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# ── Seguridad básica ────────────────────────────────────────────────

# Bloquear listado de directorios
Options -Indexes

# Bloquear acceso web directo a archivos sensibles
<FilesMatch "\.(env|log|sql|bak|lock|md|gitignore)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Bloquear acceso web directo a carpetas internas (PHP interno las usa vía require, no URL)
<IfModule mod_rewrite.c>
    RewriteRule ^vendor(/|$) - [F,L]
    RewriteRule ^logs(/|$)   - [F,L]
    RewriteRule ^core(/|$)   - [F,L]
    RewriteRule ^secure(/|$) - [F,L]
</IfModule>

# ── PHP (Hostinger shared hosting) ─────────────────────────────────
<IfModule mod_php.c>
    php_value upload_max_filesize 64M
    php_value post_max_size 64M
    php_value max_execution_time 120
</IfModule>
