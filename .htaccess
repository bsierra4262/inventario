# =====================================================================
#  INTELLIHELP Asset Vault — Apache/LiteSpeed config
#  Sintaxis Apache 2.4 compatible con LiteSpeed (Hostinger)
# =====================================================================

# Forzar HTTPS (cualquier dominio donde se aloje)
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTPS} !=on
    RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]
</IfModule>

# Bloquear listado de directorios
Options -Indexes
